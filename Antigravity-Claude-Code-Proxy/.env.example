# Antigravity Claude Proxy - environment configuration
# Copy this file to .env and fill in the values you need:
#   cp .env.example .env
# Every setting except GOOGLE_OAUTH_CLIENT_SECRET has a working default.

# --- Google OAuth (required for Google login and token refresh) ---
# The proxy does not ship an OAuth client secret. Set the secret that belongs
# to the OAuth client ID you use. Without it, `npm run accounts:add` and token
# refresh fail with "GOOGLE_OAUTH_CLIENT_SECRET is not set".
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional: use your own Google Cloud OAuth client (Desktop app type) instead
# of the default Antigravity client ID. If you set this, set the matching
# secret above.
# GOOGLE_OAUTH_CLIENT_ID=
# OAUTH_CALLBACK_PORT=51121

# --- Server ---
# PORT=8080
# LOG_LEVEL=info
